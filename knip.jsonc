{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // shadcn/ui 组件是引入的原语，导出的 API 面比应用当前用到的宽；
  // 只忽略它们的未用导出，未使用的文件仍然会被报告。
  "ignoreIssues": {
    "components/ui/*.tsx": ["exports"],
  },
  // 新增的 shadcn 原语先行入库，页面随后的改版会引用。
  "ignore": ["components/ui/card.tsx", "components/ui/skeleton.tsx"],
  // shadcn CLI 经 pnpm exec 手动调用，knip 静态分析看不到。
  "ignoreDependencies": ["shadcn"],
  // JSON Schema 生成脚本只被 package.json 的 schema:generate 调用。
  "entry": ["scripts/*.ts"],
}
