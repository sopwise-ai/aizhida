{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // shadcn/ui 组件是引入的原语，导出的 API 面比应用当前用到的宽；
  // 只忽略它们的未用导出，未使用的文件仍然会被报告。
  "ignoreIssues": {
    "components/ui/*.tsx": ["exports"],
  },
  // prettier 插件由 .prettierrc.json 加载、shadcn CLI 只在本地手动调用，
  // knip 静态分析都看不到。
  "ignoreDependencies": ["prettier-plugin-tailwindcss", "shadcn"],
}
